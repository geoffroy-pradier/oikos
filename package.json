{
  "name": "oikos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start --workdir packages/db",
    "db:stop": "supabase stop --workdir packages/db",
    "db:reset": "supabase db reset --workdir packages/db",
    "test:db": "supabase test db --workdir packages/db",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @oikos/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "supabase": "^3.1.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
