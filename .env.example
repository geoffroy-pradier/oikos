# Variables d'environnement d'OIKOS. Copier vers `.env` (jamais versionné).
# Aucun secret réel ici : uniquement des noms et des valeurs locales sans danger.

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port d'écoute de l'API de jeu (apps/api)
API_PORT=8787

# Supabase local (`pnpm db:start`). Valeurs publiques par défaut de la CLI, identiques sur toute machine :
# ce ne sont pas des secrets. Les clés sont affichées par `pnpm exec supabase status --workdir packages/db`.
SUPABASE_URL=http://127.0.0.1:54321
# L'API et le moteur agissent sous le rôle `oikos_service` (aucune propriété, écritures par les journaux).
# En local, on se connecte avec le compte de la CLI et l'option `role` fait prendre ce rôle à la connexion.
# En production, le compte de connexion des services est membre de `oikos_service` (voir infra/README.md).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?options=-c%20role%3Doikos_service

# Vérification des jetons par l'API de jeu : par défaut, clés publiques de Supabase Auth lues sur SUPABASE_URL
# (aucun secret). Ne renseigner SUPABASE_JWT_SECRET que si l'instance signe encore en HS256 ; secret saisi par un humain.
SUPABASE_JWT_SECRET=
# Client web (apps/web), lues par Vite dans le `.env` de la racine. La clé « publishable » (ou « anon ») est
# publique par nature : elle ne donne accès qu'aux vues de `public`, sous règles par ligne.
# En local : `pnpm exec supabase status --workdir packages/db`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Âge (monde de jeu) servi par le client : identifiant court du monde. Par défaut « archipel », le monde local.
VITE_WORLD_SLUG=archipel

# Limitation de débit de l'API : commandes par minute, par compte et par commande (défaut 120).
API_RATE_LIMIT_PER_MINUTE=120

# Olympe, double validation : une version de configuration est programmée par un autre compte que son
# auteur. `true` lève cette règle, pour un monde de test tenu par une seule personne ; toute autre valeur
# (ou l'absence) la maintient. Ne jamais l'activer en production.
OLYMPE_ALLOW_SELF_REVIEW=false

# Passerelle IA (ADR 0005). Tous les usages sont coupés par la configuration initiale : le jeu se joue
# sans IA, et les tests utilisent le fournisseur factice. Le fournisseur réel est le ticket #269
# (needs-human) ; sa clé est un secret saisi par un humain, jamais versionné.
AI_PROVIDER=fake
AI_API_URL=
AI_API_KEY=
