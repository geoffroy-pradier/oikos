# Proxy HTTPS. Les domaines viennent de l'environnement du serveur.
{
	email {$OIKOS_ACME_EMAIL}
}

# Fichiers statiques d'une application monopage : les fichiers nommés par leur empreinte sont mis en
# cache pour de bon, la coquille et le service worker sont toujours revalidés.
(spa) {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8787
	}
	# Un fichier d'une ancienne version qui n'existe plus répond 404, jamais la coquille.
	handle /assets/* {
		root * {args[0]}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * {args[0]}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Client joueur et API de jeu.
{$OIKOS_DOMAIN} {
	import spa /srv/web
}

# Supabase : seules les API utiles au client sont publiées. Le reste de la passerelle
# (Studio, pg-meta, MCP) n'est jamais relayé : accès par VPN uniquement (14.3).
supabase.{$OIKOS_DOMAIN} {
	@api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/*
	handle @api {
		reverse_proxy api-gw:8000
	}
	handle {
		respond 404
	}
}

# Back-office Olympe : sous-domaine distinct (docs/specs/15-back-office-olympe.md). Il lit et écrit
# par la même API de jeu, relayée sous son propre domaine.
olympe.{$OIKOS_DOMAIN} {
	import spa /srv/admin
}
