# Proxy HTTPS. Les domaines viennent de l'environnement du serveur.
{
	email {$OIKOS_ACME_EMAIL}
}

# Fichiers statiques d'une application monopage : les fichiers nommés par leur empreinte sont mis en
# cache pour de bon, la coquille et le service worker sont toujours revalidés.
(spa) {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8787
	}
	# Un fichier d'une ancienne version qui n'existe plus répond 404, jamais la coquille.
	# Le cache définitif ne vaut que pour un fichier présent : une absence n'est jamais mise en cache.
	handle /assets/* {
		root * {args[0]}
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		@absent not file
		header @absent Cache-Control "no-store"
		file_server
	}
	handle {
		root * {args[0]}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# En-têtes de sécurité des deux clients (docs/specs/14-infrastructure.md, 14.3). Politique de contenu :
# rien d'autre que les fichiers du domaine, l'API de jeu sous ce même domaine et Supabase sous le sien ;
# aucun script ni style en ligne, sauf les scripts dont l'empreinte est passée en argument ; aucune
# inclusion dans une autre page. `infra/test-static.sh` vérifie que la coquille servie la respecte.
(security) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' {args[0]}; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://supabase.{$OIKOS_DOMAIN} wss://supabase.{$OIKOS_DOMAIN}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy {args[1]}
		-Server
	}
}

# Client joueur et API de jeu. L'empreinte est celle du script de thème en ligne de `apps/web/index.html` :
# le modifier oblige à la recalculer (le contrôle des clients statiques affiche l'empreinte attendue).
{$OIKOS_DOMAIN} {
	import security "'sha256-GAYMHG+tRoWnsItEpvlekjvQTDDIMawpDA4vjlE6A4U='" strict-origin-when-cross-origin
	import spa /srv/web
}

# Supabase : seules les API utiles au client sont publiées. Le reste de la passerelle
# (Studio, pg-meta, MCP) n'est jamais relayé : accès par VPN uniquement (14.3).
supabase.{$OIKOS_DOMAIN} {
	@api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/*
	handle @api {
		reverse_proxy api-gw:8000
	}
	handle {
		respond 404
	}
}

# Back-office Olympe : sous-domaine distinct (docs/specs/15-back-office-olympe.md). Il lit et écrit
# par la même API de jeu, relayée sous son propre domaine. Aucun script en ligne ; aucune adresse d'Olympe
# ne part vers un autre site (le lien de connexion porte un jeton).
olympe.{$OIKOS_DOMAIN} {
	import security "" no-referrer
	import spa /srv/admin
}
