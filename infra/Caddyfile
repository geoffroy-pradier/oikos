# Proxy HTTPS. Les domaines viennent de l'environnement du serveur.
{
	email {$OIKOS_ACME_EMAIL}
}

# Client joueur (fichiers statiques) et API de jeu.
{$OIKOS_DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8787
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

# Supabase (Auth, PostgREST, Realtime, Storage) derrière la passerelle.
supabase.{$OIKOS_DOMAIN} {
	reverse_proxy api-gw:8000
}

# Back-office Olympe : sous-domaine distinct (docs/specs/15-back-office-olympe.md).
olympe.{$OIKOS_DOMAIN} {
	root * /srv/admin
	try_files {path} /index.html
	file_server
}
