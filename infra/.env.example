# Variables propres à OIKOS, à AJOUTER au fichier .env du compose Supabase sur le serveur.
# Aucune valeur réelle ici. Les secrets sont générés et saisis par un humain (CLAUDE.md).

# Version des images OIKOS à déployer (étiquette publiée sur le registre GitHub).
OIKOS_VERSION=
# Domaine principal : le client est servi sur ce domaine, Supabase sur supabase.<domaine>, Olympe sur olympe.<domaine>.
OIKOS_DOMAIN=
# Adresse de contact pour les certificats Let's Encrypt.
OIKOS_ACME_EMAIL=
# Connexion Postgres de l'API et du moteur, par le réseau interne du compose : un compte de connexion dédié,
# membre du rôle `oikos_service` (créé par les migrations), jamais le propriétaire des tables.
# Elle vise Postgres directement (`db:5432`) ou un pooler en mode session, jamais le port 6543 de Supavisor en mode
# transaction : le moteur tient un verrou consultatif de session pendant la chronique des cités (#271).
OIKOS_DATABASE_URL=

# Sauvegardes pgBackRest vers le stockage objet.
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_REGION=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
